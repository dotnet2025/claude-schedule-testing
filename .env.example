# Backend (ASP.NET Core reads double-underscore env vars)
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-characters
Jwt__Issuer=cms-api
Jwt__Audience=cms-clients
ConnectionStrings__Default=Data Source=cms.db
Storage__RootPath=uploads
Media__MaxUploadBytes=10485760
Cors__Origins__0=http://localhost:5173
# Development convenience only. Keep disabled in production.
Seed__Enabled=false
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=
Seed__DemoContent=false
# Frontend dev proxy target
VITE_API_TARGET=http://localhost:5080
