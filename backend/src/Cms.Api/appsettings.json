{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=cms.db" },
  "Jwt": { "Issuer": "cms-api", "Audience": "cms-clients", "SigningKey": "", "AccessTokenMinutes": 15, "RefreshTokenDays": 7 },
  "Storage": { "RootPath": "uploads" },
  "Media": { "MaxUploadBytes": 10485760 },
  "Seed": { "Enabled": false, "AdminEmail": "", "AdminPassword": "", "DemoContent": false },
  "Cors": { "Origins": [] },
  "RateLimit": { "LoginPermitPerMinute": 10 },
  "Database": { "MigrateOnStartup": true }
}
